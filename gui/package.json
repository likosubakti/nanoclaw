{
  "name": "nanoclaw-manager",
  "productName": "NanoClaw Manager",
  "version": "1.0.0",
  "description": "GUI for managing NanoClaw personal AI assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "author": "Liko",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.liko.nanoclaw-manager",
    "productName": "NanoClaw Manager",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "NanoClaw Manager",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 400 }
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  }
}
