{
  "name": "glm-studio",
  "productName": "GLM Studio",
  "version": "0.1.0",
  "description": "A Linux desktop workspace for GLM (Zhipu / Z.ai), Anthropic Claude Code, and OpenAI Codex \u2014 one GUI, one login screen, three agent backends.",
  "license": "MIT",
  "author": "likosubakti",
  "homepage": "https://github.com/likosubakti/nanoclaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/likosubakti/nanoclaw.git"
  },
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --linux dir",
    "install:desktop": "npm run build && bash scripts/install-desktop.sh",
    "uninstall:desktop": "bash scripts/uninstall-desktop.sh",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
